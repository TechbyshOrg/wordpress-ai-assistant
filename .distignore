# Files and directories listed here are NOT deployed to WordPress.org SVN trunk
# and are omitted from the GitHub release zip. Syntax matches WP-CLI / 10up deploy.
# Directory assets in .wordpress-org are copied to SVN /assets/ by the deploy action,
# not into the plugin folder.

# =============================================
# Git, GitHub, and local tooling
# =============================================
.git
.github
.gitignore
.distignore
.sample-env
.cursor
.vscode
.idea
.editorconfig
*.code-workspace

# =============================================
# WordPress.org listing assets (banners, icons, screenshots)
# Deployed to SVN assets/, not plugin trunk
# =============================================
.wordpress-org

# =============================================
# GitHub-only docs (WordPress.org uses readme.txt)
# =============================================
README.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
CHANGELOG.md

# =============================================
# JS source — compiled files live in assets/js
# =============================================
app
block-app
node_modules
npm-debug.log
yarn-error.log
yarn.lock
package-lock.json
package.json

# =============================================
# Tests, linters, and build configs
# =============================================
tests
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache
jest.config.js
.babelrc
babel.config.js
.eslintrc
.eslintrc.js
.eslintrc.json
.eslintignore
.stylelintrc
.stylelintignore
.browserslistrc
webpack.config.js
Gruntfile.js
Gulpfile.js
Makefile
.webpack
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist

# =============================================
# Environment and generated files
# =============================================
.env
.env.local
.env.production
.env.development
*.local
*.map
*.LICENSE.txt
*.log
.DS_Store
Thumbs.db
desktop.ini

# =============================================
# Composer (if added later)
# =============================================
composer.json
composer.lock
vendor
